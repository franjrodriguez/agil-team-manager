<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="806.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iesaguadulce.agilteammanager.controller.ui.seguridad.ConfiguracionController">

   <stylesheets>
      <URL value="@../../css/primer-light.css" />
      <URL value="@../../css/agilteam-styles.css" />
   </stylesheets>

   <!-- ══ CABECERA ══════════════════════════════════════════════ -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="72.0" spacing="12.0"
            style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
         <padding><Insets left="24.0" right="24.0" /></padding>
         <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
            <image><Image url="@../../icons/menu/config-naranja.png" /></image>
         </ImageView>
         <VBox spacing="2.0">
            <Label text="Configuración" styleClass="view-title" />
            <Label text="Parámetros del sistema y seguridad" styleClass="view-subtitle" />
         </VBox>
      </HBox>
   </top>

   <!-- ══ CONTENIDO ═════════════════════════════════════════════ -->
   <center>
      <ScrollPane fitToWidth="true"
                  style="-fx-background-color: #F8FAFC; -fx-background: #F8FAFC; -fx-border-width: 0;">
         <content>
            <VBox spacing="20.0" style="-fx-background-color: #F8FAFC;">
               <padding><Insets top="24.0" right="32.0" bottom="32.0" left="32.0" /></padding>

               <!-- ─── CARD: SEGURIDAD ─────────────────────────────── -->
               <VBox style="-fx-background-color: white; -fx-background-radius: 8;
                            -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1;">
                  <padding><Insets top="20.0" right="24.0" bottom="24.0" left="24.0" /></padding>

                  <!-- Encabezado de la card -->
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../../icons/menu/securiry-naranja.png" /></image>
                     </ImageView>
                     <Label text="Seguridad" styleClass="section-title" />
                  </HBox>
                  <Separator>
                     <VBox.margin><Insets top="10.0" bottom="16.0" /></VBox.margin>
                  </Separator>

                  <!-- Fila: descripción + botón -->
                  <HBox alignment="CENTER_LEFT" spacing="24.0">
                     <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label text="Resetear contraseñas de todos los usuarios"
                               style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1F2937;" />
                        <Label text="Establece la contraseña '1234' para todos los usuarios del sistema. Útil para entornos de desarrollo o recuperación masiva."
                               style="-fx-text-fill: #6B7280; -fx-font-size: 13px;"
                               wrapText="true" maxWidth="700.0" />
                     </VBox>
                     <Button text="Resetear a '1234'"
                             onAction="#onResetearPasswords"
                             style="-fx-background-color: #DC2626; -fx-text-fill: white;
                                    -fx-font-size: 13px; -fx-font-weight: bold;
                                    -fx-background-radius: 6; -fx-cursor: hand;
                                    -fx-padding: 10 20 10 20;" />
                  </HBox>

                  <!-- Mensaje de estado -->
                  <Label fx:id="lblResetEstado" text="" prefHeight="22.0">
                     <VBox.margin><Insets top="10.0" /></VBox.margin>
                  </Label>
               </VBox>

               <!-- ─── CARD: MOTOR DE ASIGNACIÓN ──────────────────── -->
               <VBox style="-fx-background-color: white; -fx-background-radius: 8;
                            -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1;">
                  <padding><Insets top="20.0" right="24.0" bottom="24.0" left="24.0" /></padding>

                  <!-- Encabezado de la card -->
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../../icons/menu/metric-azul-cyan.png" /></image>
                     </ImageView>
                     <Label text="Motor de Asignación — Parámetros" styleClass="section-title" />
                  </HBox>
                  <Separator>
                     <VBox.margin><Insets top="10.0" bottom="16.0" /></VBox.margin>
                  </Separator>

                  <!-- Grid de parámetros -->
                  <GridPane hgap="24.0" vgap="16.0">
                     <columnConstraints>
                        <ColumnConstraints minWidth="280.0" />
                        <ColumnConstraints minWidth="130.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                     </columnConstraints>

                     <!-- Fila 0: Carga máxima -->
                     <Label text="Carga máxima permitida (%)"
                            style="-fx-font-size: 13px; -fx-text-fill: #374151;"
                            GridPane.columnIndex="0" GridPane.rowIndex="0" />
                     <Spinner fx:id="spinnerCargaMaxima" prefWidth="120.0" editable="true"
                              GridPane.columnIndex="1" GridPane.rowIndex="0" />
                     <Label text="Umbral máximo de carga de trabajo para considerar un profesional como candidato."
                            style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;"
                            wrapText="true"
                            GridPane.columnIndex="2" GridPane.rowIndex="0" />

                     <!-- Fila 1: Competencia mínima -->
                     <Label text="Nivel mínimo de competencia (1–5)"
                            style="-fx-font-size: 13px; -fx-text-fill: #374151;"
                            GridPane.columnIndex="0" GridPane.rowIndex="1" />
                     <Spinner fx:id="spinnerCompetenciaMinima" prefWidth="120.0" editable="true"
                              GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     <Label text="Nivel mínimo requerido de competencia para que el profesional entre en la selección."
                            style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;"
                            wrapText="true"
                            GridPane.columnIndex="2" GridPane.rowIndex="1" />

                     <!-- Fila 2: Candidatos máximos -->
                     <Label text="Candidatos máximos a mostrar"
                            style="-fx-font-size: 13px; -fx-text-fill: #374151;"
                            GridPane.columnIndex="0" GridPane.rowIndex="2" />
                     <Spinner fx:id="spinnerCandidatosMax" prefWidth="120.0" editable="true"
                              GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     <Label text="Número máximo de candidatos que el motor mostrará por tarea."
                            style="-fx-text-fill: #9CA3AF; -fx-font-size: 12px;"
                            wrapText="true"
                            GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  </GridPane>

                  <!-- Botón guardar + estado -->
                  <HBox alignment="CENTER_LEFT" spacing="16.0">
                     <VBox.margin><Insets top="20.0" /></VBox.margin>
                     <Button text="Guardar parámetros"
                             onAction="#onGuardarMotor"
                             style="-fx-background-color: #2563EB; -fx-text-fill: white;
                                    -fx-font-size: 13px; -fx-font-weight: bold;
                                    -fx-background-radius: 6; -fx-cursor: hand;
                                    -fx-padding: 10 20 10 20;" />
                     <Label fx:id="lblMotorEstado" text="" />
                  </HBox>

               </VBox>

            </VBox>
         </content>
      </ScrollPane>
   </center>

</BorderPane>
