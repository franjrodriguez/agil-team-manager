<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!--
╔══════════════════════════════════════════════════════════════════╗
║  MisTareasView.fxml  –  1200 × 806 px                           ║
║  Estilos: primer-light.css  +  agilteam-styles.css              ║
╚══════════════════════════════════════════════════════════════════╝
-->
<BorderPane fx:id="rootPane"
            prefHeight="806.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iesaguadulce.agilteammanager.controller.ui.perfil.MisTareasController">

    <stylesheets>
        <URL value="@../../css/primer-light.css" />
        <URL value="@../../css/agilteam-styles.css" />
    </stylesheets>

    <!-- ═══════════════════════════════════════════════════════
         TOP — Cabecera fija
         ═══════════════════════════════════════════════════════ -->
    <top>
        <HBox fx:id="headerBox" alignment="CENTER_LEFT" prefHeight="72.0" spacing="14.0"
              style="-fx-background-color: -app-bg-card;
                     -fx-border-color: -app-border-soft;
                     -fx-border-width: 0 0 1 0;">
            <padding><Insets top="0" right="24" bottom="0" left="24" /></padding>

            <ImageView fx:id="profileAvatar1" fitHeight="40.0" fitWidth="40.0"
                       pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../../icons/tareas.png" /></image>
            </ImageView>

            <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="Mis Tareas" />
                <Label styleClass="page-subtitle" text="Tareas asignadas a tu perfil" />
            </VBox>

            <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#onCancelar"
                    prefHeight="36.0" prefWidth="140.0"
                    style="-fx-background-color: #E5E7EB; -fx-text-fill: #374151;
                           -fx-background-radius: 6; -fx-font-weight: 600;"
                    text="Cancelar" />
            <Button fx:id="btnSave" mnemonicParsing="false" onAction="#onGuardarEstado"
                    prefHeight="36.0" prefWidth="160.0"
                    styleClass="primary" text="Guardar Cambios" />
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════════════════
         LEFT — Panel lateral con perfil + lista de tareas
         ═══════════════════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebarPanel" prefHeight="734.0" prefWidth="380.0" spacing="12.0"
              styleClass="app-panel" BorderPane.alignment="CENTER">
            <padding><Insets top="16" right="16" bottom="16" left="16" /></padding>

            <!-- Mini-card de perfil del usuario -->
            <VBox fx:id="topBox" spacing="8.0"
                  style="-fx-background-color: -app-bg-workspace;
                         -fx-background-radius: 8;
                         -fx-border-color: -app-border-soft;
                         -fx-border-radius: 8;
                         -fx-border-width: 1;
                         -fx-padding: 12;">
                <ImageView fx:id="profileAvatar" fitHeight="48.0" fitWidth="48.0"
                           pickOnBounds="true" preserveRatio="true" />
                <Label fx:id="profileName" styleClass="section-title" text="Tu Nombre" />
                <HBox fx:id="hboxHeader" spacing="8.0" alignment="CENTER_LEFT">
                    <Label fx:id="profileRole" styleClass="page-subtitle" text="Puesto" />
                    <Separator prefHeight="16.0" prefWidth="8.0" visible="false" />
                    <Label fx:id="profileStatus" styleClass="page-subtitle" text="ACTIVO" />
                </HBox>
            </VBox>

            <TextField fx:id="searchField" prefHeight="38.0"
                       promptText="Buscar tarea..." />

            <ListView fx:id="tasksListView" onMouseClicked="#seleccionarTarea"
                      VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════════
         CENTER — Detalle de la tarea seleccionada
         ═══════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fx:id="detailScrollPane" hbarPolicy="NEVER" fitToWidth="true"
                    BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="detailPane" spacing="16.0"
                      style="-fx-background-color: -app-bg-workspace;">
                    <padding><Insets top="28" right="32" bottom="32" left="32" /></padding>

                    <!-- Detalle de la tarea -->
                    <VBox fx:id="taskSection" spacing="16.0"
                          style="-fx-background-color: -app-bg-card;
                                 -fx-background-radius: 8;
                                 -fx-border-color: -app-border-soft;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;
                                 -fx-padding: 16;">

                        <HBox fx:id="taskSectionHeader" alignment="CENTER_LEFT">
                            <Label styleClass="section-title" text="Detalle de la Tarea"
                                   HBox.hgrow="ALWAYS" />
                        </HBox>

                        <Separator />

                        <VBox fx:id="nombreBox" spacing="6.0">
                            <Label fx:id="labelNombre" styleClass="form-label" text="TÍTULO" />
                            <TextField fx:id="nombreField" prefHeight="36.0"
                                       promptText="Título de la tarea" />
                        </VBox>

                        <VBox fx:id="descripcionBox" spacing="6.0">
                            <Label fx:id="descripcionLabel" styleClass="form-label"
                                   text="DESCRIPCIÓN" />
                            <TextArea fx:id="descripcionField" prefHeight="100.0"
                                      wrapText="true"
                                      promptText="Descripción detallada de la tarea..." />
                        </VBox>

                        <!-- Metadatos: proyecto, sprint, estimación, fecha -->
                        <GridPane fx:id="personalDataGrid" hgap="24.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>

                            <Label styleClass="form-label" text="PROYECTO" />
                            <Label styleClass="form-label" text="SPRINT"
                                   GridPane.columnIndex="1" />

                            <Label fx:id="proyectNameLabel" styleClass="form-label"
                                   text="—" GridPane.rowIndex="1" />
                            <Label fx:id="sprintTitleLabel" styleClass="form-label"
                                   text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label styleClass="form-label" text="ESTIMACIÓN"
                                   GridPane.rowIndex="2">
                                <GridPane.margin><Insets top="8.0" /></GridPane.margin>
                            </Label>
                            <Label styleClass="form-label" text="FECHA ASIGNACIÓN"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <GridPane.margin><Insets top="8.0" /></GridPane.margin>
                            </Label>

                            <HBox fx:id="estimationLabel" alignment="CENTER_LEFT"
                                  GridPane.rowIndex="3">
                                <Label prefWidth="335.0" styleClass="form-label" text="—" />
                            </HBox>
                            <DatePicker fx:id="asignDatePicker" prefHeight="36.0" prefWidth="150.0"
                                        promptText="Fecha asignación"
                                        GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        </GridPane>
                    </VBox>

                    <!-- Cambiar estado -->
                    <VBox fx:id="competenciesSection" spacing="12.0"
                          style="-fx-background-color: -app-bg-card;
                                 -fx-background-radius: 8;
                                 -fx-border-color: -app-border-soft;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;
                                 -fx-padding: 16;">

                        <HBox fx:id="taskSectionHeader1" alignment="CENTER_LEFT">
                            <Label styleClass="section-title" text="Cambiar Estado"
                                   HBox.hgrow="ALWAYS" />
                        </HBox>

                        <Separator />

                        <VBox spacing="6.0">
                            <Label styleClass="form-label"
                                   text="NUEVO ESTADO" />
                            <ComboBox fx:id="statusTaskCombobox" prefHeight="36.0"
                                      maxWidth="1.7976931348623157E308"
                                      promptText="Pendiente / En progreso / Revisión / Completada / Bloqueada" />
                        </VBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <!-- Nodo fantasma -->
                    <HBox fx:id="actionButtons" visible="false" managed="false" />

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
