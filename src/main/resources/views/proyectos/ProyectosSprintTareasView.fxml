<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
╔══════════════════════════════════════════════════════════════════╗
║  GestionProyectos.fxml  –  960 × 700 px                         ║
║  Estilos: primer-light.css  +  agilteam-styles.css              ║
║                                                                  ║
║  ESTRUCTURA DE CAPAS (StackPane apila hijos en Z):              ║
║                                                                  ║
║  ┌─ StackPane (root) ──────────────────────────────────────┐   ║
║  │                                                          │   ║
║  │  [CAPA 0] BorderPane ← TU LAYOUT NORMAL (sin tocar)    │   ║
║  │  [CAPA 1] Pane overlayOscuro ← fondo semitransparente  │   ║
║  │  [CAPA 2] HBox > VBox drawerPanel ← formulario lateral  │   ║
║  │                                                          │   ║
║  └──────────────────────────────────────────────────────────┘   ║
║                                                                  ║
║  Capas 1 y 2 comienzan ocultas/fuera de pantalla.               ║
║  El controller las anima al pulsar "Nueva Tarea"/"Nuevo Sprint" ║
╚══════════════════════════════════════════════════════════════════╝
-->

<StackPane prefHeight="806" prefWidth="1200" stylesheets="@../css/primer-light.css,@../css/agilteam-styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iesaguadulce.agilteammanager.controller.ui.proyectos.ProyectosController">


    <!-- ═══════════════════════════════════════════════════════════
         CAPA 0 ─ TU BORDERPANE DE SIEMPRE
         No cambia nada respecto a lo que ya tenías montado.
         Solo está envuelto en el StackPane padre.
         ═══════════════════════════════════════════════════════════ -->
    <BorderPane>

        <!-- ── IZQUIERDA: Panel lista de proyectos ── -->
        <left>
            <VBox maxWidth="260" minWidth="260" prefWidth="260" style="-fx-background-color: white;                          -fx-border-color: #E5E7EB;                          -fx-border-width: 0 1 0 0;">

                <!-- Cabecera: título + contador -->
                <HBox alignment="CENTER_LEFT" style="-fx-padding: 16 16 8 16;">
                    <Label style="-fx-font-size: 11px; -fx-font-weight: 700;                                   -fx-text-fill: #6B7280; -fx-letter-spacing: 0.8;" text="GESTIÓN DE PROYECTOS" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblTotalProyectos" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;" text="0 TOTAL" />
                </HBox>

                <!-- Buscador -->
                <HBox style="-fx-padding: 0 12 8 12;">
                    <TextField fx:id="buscarProyectoField" promptText="Buscar proyectos..." style="-fx-font-size: 13px;                                       -fx-background-radius: 6; -fx-border-radius: 6;                                       -fx-border-color: #D1D5DB; -fx-padding: 7 10;" HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Botón añadir proyecto -->
                <HBox style="-fx-padding: 0 12 12 12;">
                    <Button fx:id="btnAnadirProyecto" maxWidth="Infinity" onAction="#onAnadirProyecto" style="-fx-font-size: 14px; -fx-padding: 10 0;                                    -fx-background-radius: 8;" styleClass="button,primary" text="⊕  Añadir Proyecto" HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Lista dinámica de proyectos (se puebla desde el controller) -->
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;                                    -fx-border-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="listaProyectos" style="-fx-padding: 0 6;">
                  <children>
                     <ListView fx:id="proyectoListView" prefHeight="547.0" prefWidth="245.0" />
                  </children></VBox>
                </ScrollPane>

            </VBox>
        </left>

        <!-- ── CENTRO: Detalle del proyecto seleccionado ── -->
        <center>
            <ScrollPane fitToHeight="false" fitToWidth="true" style="-fx-background-color: #F8F7F4;                                -fx-border-color: transparent;">
                <VBox fx:id="panelDetalle" minWidth="640" style="-fx-padding: 24; -fx-spacing: 20;">

                    <!-- ·· Card cabecera del proyecto ·· -->
                    <VBox fx:id="sustituir" style="-fx-background-color: white;                                  -fx-background-radius: 10;                                  -fx-border-color: #E5E7EB;                                  -fx-border-radius: 10;                                  -fx-padding: 20;">

                        <!-- Nombre + badge estado -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="lblNombreProyecto" styleClass="section-title" text="Selecciona un proyecto" />
                            <Label fx:id="lblEstadoProyecto" style="-fx-font-size: 11px; -fx-font-weight: 700;                                           -fx-text-fill: #10B981;                                           -fx-background-color: #D1FAE5;                                           -fx-background-radius: 20; -fx-padding: 3 10;" text="" />
                        </HBox>

                        <!-- Descripción -->
                        <Label fx:id="lblDescripcionProyecto" style="-fx-font-size: 13px; -fx-text-fill: #6B7280;                                       -fx-padding: 6 0 12 0;" text="" wrapText="true" />

                        <!-- Botones editar / compartir -->
                        <HBox spacing="8">
                            <Button fx:id="btnEditarProyecto" onAction="#onEditarProyecto" style="-fx-background-color: #F3F4F6;                                            -fx-border-color: #E5E7EB;                                            -fx-border-radius: 6; -fx-background-radius: 6;                                            -fx-padding: 8 12; -fx-font-size: 14px;" text="✏" />
                            <Button style="-fx-background-color: #F3F4F6;                                            -fx-border-color: #E5E7EB;                                            -fx-border-radius: 6; -fx-background-radius: 6;                                            -fx-padding: 8 12; -fx-font-size: 14px;" text="⤴" />
                        </HBox>

                        <!-- Métricas: inicio / fin / equipo / progreso -->
                        <HBox spacing="24" style="-fx-padding: 16 0 0 0;">
                            <VBox spacing="2">
                                <Label style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;" text="INICIO" />
                                <Label fx:id="lblFechaInicio" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1F2937;" text="—" />
                            </VBox>
                            <VBox spacing="2">
                                <Label style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;" text="FIN ESTIMADO" />
                                <Label fx:id="lblFechaFin" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1F2937;" text="—" />
                            </VBox>
                            <VBox spacing="2">
                                <Label style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;" text="EQUIPO" />
                                <Label fx:id="lblEquipo" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1F2937;" text="—" />
                            </VBox>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF; -fx-font-weight: 600;" text="PROGRESO" />
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <ProgressBar fx:id="barraProgreso" prefHeight="8" prefWidth="120" progress="0" style="-fx-accent: #3B82F6;" />
                                    <Label fx:id="lblPorcentaje" style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #1F2937;" text="0%" />
                                </HBox>
                            </VBox>
                        </HBox>

                    </VBox>

                    <!-- ·· Card Sprints ·· -->
                    <VBox style="-fx-background-color: white;                                  -fx-background-radius: 10;                                  -fx-border-color: #E5E7EB;                                  -fx-border-radius: 10;                                  -fx-padding: 16; -fx-spacing: 10;">

                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #1F2937;" text="Ciclos de Trabajo (Sprints)" />
                            <Region HBox.hgrow="ALWAYS" />
                            <!-- ★ Este botón abre el drawer con NuevoSprint.fxml -->
                            <Button fx:id="btnNuevoSprint" onAction="#onNuevoSprint" style="-fx-background-color: transparent;                                            -fx-border-color: transparent;                                            -fx-text-fill: #3B82F6;                                            -fx-font-weight: 600; -fx-font-size: 13px;                                            -fx-cursor: hand; -fx-padding: 0;" text="+ AÑADIR SPRINT" />
                        </HBox>

                        <TableView fx:id="tablaSprints" prefHeight="150" style="-fx-background-color: transparent;                                           -fx-border-color: #E5E7EB;                                           -fx-border-radius: 6; -fx-background-radius: 6;" VBox.vgrow="NEVER">
                            <columns>
                                <TableColumn fx:id="colSprintObjetivo" prefWidth="260" text="OBJETIVO" />
                                <TableColumn fx:id="colSprintEstado" prefWidth="110" text="ESTADO" />
                                <TableColumn fx:id="colSprintInicio" prefWidth="80" text="INICIO" />
                                <TableColumn fx:id="colSprintFin" prefWidth="80" text="FIN" />
                                <TableColumn fx:id="colSprintAcciones" prefWidth="90" text="ACCIONES" />
                            </columns>
                            <placeholder>
                                <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;" text="No hay sprints todavía." />
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- ·· Card Tareas ·· -->
                    <VBox style="-fx-background-color: white;                                  -fx-background-radius: 10;                                  -fx-border-color: #E5E7EB;                                  -fx-border-radius: 10;                                  -fx-padding: 16; -fx-spacing: 10;">

                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #1F2937;" text="Listado de Tareas" />
                            <Region HBox.hgrow="ALWAYS" />
                            <!-- ★ Este botón abre el drawer con NuevaTarea.fxml -->
                            <Button fx:id="btnNuevaTarea" onAction="#onNuevaTarea" style="-fx-background-color: #F3F4F6;                                            -fx-border-color: #E5E7EB;                                            -fx-border-radius: 6; -fx-background-radius: 6;                                            -fx-font-size: 12px; -fx-font-weight: 600;                                            -fx-text-fill: #374151;                                            -fx-padding: 6 12; -fx-cursor: hand;" text="✦ NUEVA TAREA" />
                        </HBox>

                        <TableView fx:id="tablaTareas" prefHeight="200" style="-fx-background-color: transparent;                                           -fx-border-color: #E5E7EB;                                           -fx-border-radius: 6; -fx-background-radius: 6;" VBox.vgrow="NEVER">
                            <columns>
                                <TableColumn fx:id="colTareaTitulo" prefWidth="240" text="TÍTULO" />
                                <TableColumn fx:id="colTareaEstado" prefWidth="110" text="ESTADO" />
                                <TableColumn fx:id="colTareaPrioridad" prefWidth="90" text="PRIORIDAD" />
                                <TableColumn fx:id="colTareaHoras" prefWidth="70" text="H. EST." />
                                <TableColumn fx:id="colTareaAcciones" prefWidth="90" text="ACCIONES" />
                            </columns>
                            <placeholder>
                                <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;" text="No hay tareas en este proyecto." />
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>
        </center>

    </BorderPane>
    <!-- ═══ FIN CAPA 0 / FIN BORDERPANE ═══════════════════════════════════ -->


    <!-- ═══════════════════════════════════════════════════════════
         CAPA 1 ─ OVERLAY OSCURO
         ──────────────────────────────────────────────────────────
         • opacity="0"          → completamente invisible al inicio
         • mouseTransparent="true" → no bloquea clics cuando está oculto
         • Al abrir drawer: FadeTransition opacity 0 → 1
                            mouseTransparent → false
         • Clic sobre el overlay → cierra el drawer
         ═══════════════════════════════════════════════════════════ -->
    <Pane fx:id="overlayOscuro" mouseTransparent="true" onMouseClicked="#onCerrarDrawer" opacity="0" style="-fx-background-color: rgba(0,0,0,0.45);" />


    <!-- ═══════════════════════════════════════════════════════════
         CAPA 2 ─ PANEL DRAWER (VBox normal pegado a la derecha)
         ──────────────────────────────────────────────────────────
         • HBox alignment=CENTER_RIGHT hace que el VBox quede
           siempre pegado al borde derecho del StackPane.
         • translateX="380" → empieza 380px fuera de pantalla
         • Al abrir: TranslateTransition translateX 380 → 0
         • Al cerrar: TranslateTransition translateX 0 → 380
         • El StackPane fx:id="drawerContenido" es el SLOT vacío
           donde el controller inyecta NuevaTarea.fxml o
           NuevoSprint.fxml con FXMLLoader en tiempo de ejecución.
         ═══════════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_RIGHT" mouseTransparent="true">
        <VBox fx:id="drawerPanel" maxWidth="380" mouseTransparent="true" prefWidth="380" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, -4, 0);" translateX="380">

            <!-- SLOT: aquí se carga dinámicamente NuevaTarea.fxml
                       o NuevoSprint.fxml desde el controller -->
            <StackPane fx:id="drawerContenido" VBox.vgrow="ALWAYS" />

        </VBox>
    </HBox>
    <!-- ═══ FIN CAPA 2 ════════════════════════════════════════════ -->


</StackPane>
