<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
╔══════════════════════════════════════════════════════════════════╗
║  ProyectosTareasView.fxml  –  1200 × 806 px                     ║
║  Estilos: primer-light.css  +  agilteam-styles.css              ║
║                                                                  ║
║  ESTRUCTURA DE CAPAS (StackPane apila hijos en Z):              ║
║                                                                  ║
║  ┌─ StackPane (root) ──────────────────────────────────────┐   ║
║  │                                                          │   ║
║  │  [CAPA 0] BorderPane ← layout principal                 │   ║
║  │  [CAPA 1] Pane overlayOscuro ← fondo semitransparente  │   ║
║  │  [CAPA 2] HBox > VBox drawerPanel ← formulario lateral  │   ║
║  │                                                          │   ║
║  └──────────────────────────────────────────────────────────┘   ║
║                                                                  ║
║  Capas 1 y 2 comienzan ocultas/fuera de pantalla.               ║
║  El controller las anima al pulsar "Añadir Sprint"/"Nueva Tarea"║
╚══════════════════════════════════════════════════════════════════╝

  DISTRIBUCIÓN DE ESPACIO (cálculo):
  Ventana 1200px − sidebar 380px = 820px centro
  ScrollPane fitToWidth → VBox padding 32+32 = 756px para HBox
  HBox spacing 16px → dos columnas de ~370px cada una
  Card padding 16+16 = 32px → tabla interior ~338px

  COLUMNAS SPRINTS   (338px): objetivo(105) estado(53) inicio(58) fin(58) acciones(64)
  COLUMNAS TAREAS    (338px): titulo(76) estado(48) prioridad(54) tiempo(hidden) acciones(160)
  COLUMNAS COMPET.   (338px): nombre(140) peso(60) acciones(138)
-->

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
           prefHeight="806.0" prefWidth="1200.0"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.iesaguadulce.agilteammanager.controller.ui.proyectos.ProyectosController">

    <stylesheets>
        <URL value="@../../css/primer-light.css" />
        <URL value="@../../css/agilteam-styles.css" />
    </stylesheets>

    <!-- ═══════════════════════════════════════════════════════════
         CAPA 0 ─ BORDERPANE PRINCIPAL
         ═══════════════════════════════════════════════════════════ -->
    <BorderPane fx:id="rootPane" styleClass="bg-default">

        <!-- ── IZQUIERDA: Panel lista de proyectos ── -->
        <left>
            <VBox fx:id="sidebarPanel" prefWidth="380.0" spacing="12.0"
                  styleClass="app-panel" BorderPane.alignment="TOP_LEFT">
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                </padding>
                <children>
                    <TextField fx:id="searchField" prefHeight="40.0" promptText="Buscar proyectos..." />
                    <HBox fx:id="filterBox" prefHeight="40.0" spacing="8.0">
                        <children>
                            <ComboBox fx:id="statusFilter" prefHeight="36.0" prefWidth="227.0" promptText="STATUS" />
                            <ComboBox fx:id="deptFilter" prefWidth="116.0" promptText="DEPT" visible="false" managed="false" />
                            <ComboBox fx:id="roleFilter" prefWidth="116.0" promptText="ROL" visible="false" managed="false" />
                        </children>
                    </HBox>
                    <Button fx:id="btnAddProyecto" mnemonicParsing="false"
                            prefHeight="40.0" prefWidth="348.0"
                            styleClass="primary" text="Añadir Proyecto Nuevo" />
                    <ListView fx:id="proyectoListView" prefWidth="348.0" VBox.vgrow="ALWAYS" />
                </children>
            </VBox>
        </left>

        <!-- ── TOP: Cabecera fija del proyecto ── -->
        <top>
            <HBox fx:id="headerBox" alignment="CENTER_LEFT" prefHeight="72.0" spacing="14.0"
                  style="-fx-background-color: -app-bg-card;
                         -fx-border-color: -app-border-soft;
                         -fx-border-width: 0 0 1 0;">
                <padding><Insets top="0" right="24" bottom="0" left="24" /></padding>

                <ImageView fx:id="profileAvatar" fitHeight="40.0" fitWidth="40.0"
                           pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../../icons/project.png" /></image>
                </ImageView>

                <VBox fx:id="headerInfo" alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="projectName" styleClass="section-title" text="Proyectos y Tareas" />
                    <Label fx:id="projectDescriptionBreve" styleClass="page-subtitle"
                           text="Selecciona un proyecto" />
                </VBox>

                <ComboBox fx:id="statusComboBox" prefHeight="34.0" prefWidth="140.0"
                          promptText="Estado" />

                <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#onBorrarProyecto"
                        prefHeight="36.0" prefWidth="150.0"
                        style="-fx-background-color: -app-error; -fx-text-fill: white;
                               -fx-background-radius: 6; -fx-font-weight: 600;"
                        text="Borrar Proyecto" />
                <Button fx:id="btnSave" mnemonicParsing="false" onAction="#onGuardarProyecto"
                        prefHeight="36.0" prefWidth="160.0"
                        styleClass="primary" text="Guardar Cambios" />
            </HBox>
        </top>

        <!-- ── CENTRO: Detalle del proyecto ── -->
        <center>
            <ScrollPane fx:id="detailScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                        BorderPane.alignment="TOP_LEFT">
                <content>
                    <VBox fx:id="detailPane" maxWidth="1.7976931348623157E308" spacing="20.0"
                          style="-fx-background-color: -app-bg-workspace;">
                        <padding>
                            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
                        </padding>
                        <children>

                            <!-- ·· Card datos del proyecto ·· -->
                            <!--
                                GridPane 3 columnas, 4 filas:
                                F0 (labels):  NOMBRE | FECHA COMIENZO | FECHA FINALIZACIÓN
                                F1 (campos):  TextField | DatePicker   | DatePicker
                                F2 (label):   DESCRIPCIÓN (colspan=3)
                                F3 (campo):   TextArea (colspan=3)
                            -->
                            <GridPane fx:id="personalDataGrid" hgap="24.0" vgap="12.0"
                                      style="-fx-background-color: -app-bg-card;
                                             -fx-background-radius: 8;
                                             -fx-border-color: -app-border-soft;
                                             -fx-border-radius: 8;
                                             -fx-border-width: 1;">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" prefWidth="260.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="140.0" prefWidth="180.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="140.0" prefWidth="180.0" />
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints minHeight="20.0" />
                                    <RowConstraints minHeight="36.0" />
                                    <RowConstraints minHeight="20.0" />
                                    <RowConstraints minHeight="52.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                <padding>
                                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                </padding>
                                <children>
                                    <!-- Fila 0: labels -->
                                    <Label style="-fx-text-fill: -app-text-secondary;" styleClass="form-label"
                                           text="NOMBRE"
                                           GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Label style="-fx-text-fill: -app-text-secondary;" styleClass="form-label"
                                           text="FECHA COMIENZO"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Label style="-fx-text-fill: -app-text-secondary;" styleClass="form-label"
                                           text="FECHA FINALIZACIÓN"
                                           GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <!-- Fila 1: campos -->
                                    <TextField fx:id="nombreField" prefHeight="36.0"
                                               promptText="Nombre del proyecto"
                                               GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <DatePicker fx:id="fechacomienzoDate" prefHeight="36.0" prefWidth="170.0"
                                                promptText="Fecha inicio"
                                                GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <DatePicker fx:id="fechafinDate" prefHeight="36.0" prefWidth="170.0"
                                                promptText="Fecha fin" styleClass="btn-secondary"
                                                GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <!-- Fila 2: label descripción -->
                                    <Label style="-fx-text-fill: -app-text-secondary;" styleClass="form-label"
                                           text="DESCRIPCIÓN"
                                           GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="2" />
                                    <!-- Fila 3: TextArea descripción -->
                                    <TextArea fx:id="descripcionField" prefHeight="52.0"
                                              promptText="Descripción del proyecto..." wrapText="true"
                                              GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="3" />
                                </children>
                            </GridPane>

                            <!-- ══════════════════════════════════════════════════
                                 BLOQUE PRINCIPAL: 2 columnas lado a lado
                                 ─ Izquierda : Sprints (hgrow=ALWAYS)
                                 ─ Derecha   : Tareas + Competencias (prefWidth=340)
                                 Total HBox: 756px, spacing=16 → ~400px | ~340px
                                 ══════════════════════════════════════════════════ -->
                            <!--
                                 Distribución 50/50:
                                 (756px HBox − 16px spacing) / 2 = 370px por columna
                                 370px card − 32px padding = 338px tabla (ambos lados iguales)
                            -->
                            <HBox fx:id="seccionBloqueTablas" spacing="16.0" alignment="TOP_LEFT"
                                  VBox.vgrow="ALWAYS">

                                <!-- ── IZQUIERDA: Card Sprints ── -->
                                <VBox fx:id="sprintsSection" spacing="12.0" minWidth="320.0"
                                      style="-fx-background-color: -app-bg-card;
                                             -fx-background-radius: 8;
                                             -fx-border-color: -app-border-soft;
                                             -fx-border-radius: 8;
                                             -fx-border-width: 1;"
                                      HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                    </padding>
                                    <children>
                                        <HBox fx:id="sprintSectionHeader" alignment="CENTER_LEFT" spacing="12.0">
                                            <children>
                                                <ImageView fx:id="profileAvatar1"
                                                           fitHeight="32.0" fitWidth="32.0"
                                                           pickOnBounds="true" preserveRatio="true"
                                                           style="-fx-effect: dropshadow(gaussian, #00000019, 8, 0, 0, 2);">
                                                    <image><Image url="@../../icons/sprints.png" /></image>
                                                </ImageView>
                                                <Label styleClass="section-title"
                                                       text="Ciclos de Trabajo (Sprints)"
                                                       HBox.hgrow="ALWAYS" />
                                                <Separator prefHeight="25.0" visible="false" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="btnAddSprint" mnemonicParsing="false"
                                                        onAction="#onNuevoSprint"
                                                        prefHeight="36.0" prefWidth="160.0"
                                                        styleClass="btn-secondary" text="+ AÑADIR SPRINT" />
                                            </children>
                                        </HBox>
                                        <!--
                                            Tabla Sprints — 370px card, 32px padding → 338px tabla
                                            objetivo(109) estado(53) inicio(58) fin(58) acciones(60) = 338
                                        -->
                                        <TableView fx:id="sprintsTable" prefHeight="180.0" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="objetivoColumn" prefWidth="109.0" text="OBJETIVO" />
                                                <TableColumn fx:id="estadoColumn" prefWidth="53.0" text="ESTADO" />
                                                <TableColumn fx:id="inicioColumn" prefWidth="58.0" text="INICIO" />
                                                <TableColumn fx:id="finColumn" prefWidth="58.0" text="FIN" />
                                                <TableColumn fx:id="accionesColumn" prefWidth="60.0" text="ACCIONES" />
                                            </columns>
                                            <placeholder>
                                                <Label style="-fx-text-fill: -app-text-secondary; -fx-font-size: 13px;"
                                                       text="No hay sprints todavía." />
                                            </placeholder>
                                        </TableView>
                                    </children>
                                </VBox>

                                <!-- ── DERECHA: Tareas + Competencias apiladas ── -->
                                <VBox fx:id="seccionBloqueDerecha" spacing="12.0" minWidth="320.0"
                                      HBox.hgrow="ALWAYS">

                                    <!-- ·· Card Tareas ·· -->
                                    <VBox fx:id="tareasSeccion" spacing="12.0"
                                          style="-fx-background-color: -app-bg-card;
                                                 -fx-background-radius: 8;
                                                 -fx-border-color: -app-border-soft;
                                                 -fx-border-radius: 8;
                                                 -fx-border-width: 1;"
                                          VBox.vgrow="ALWAYS">
                                        <padding>
                                            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                        </padding>
                                        <children>
                                            <HBox fx:id="tareasCabecera" alignment="CENTER_LEFT" spacing="12.0">
                                                <children>
                                                    <ImageView fx:id="profileAvatar11"
                                                               fitHeight="32.0" fitWidth="32.0"
                                                               pickOnBounds="true" preserveRatio="true"
                                                               style="-fx-effect: dropshadow(gaussian, #00000019, 8, 0, 0, 2);">
                                                        <image><Image url="@../../icons/tareas.png" /></image>
                                                    </ImageView>
                                                    <Label styleClass="section-title" text="Tareas Asociadas"
                                                           HBox.hgrow="ALWAYS" />
                                                    <Separator prefHeight="25.0" visible="false" HBox.hgrow="ALWAYS" />
                                                    <Button fx:id="btnAddTask" mnemonicParsing="false"
                                                            onAction="#onNuevaTarea"
                                                            prefHeight="36.0" prefWidth="140.0"
                                                            styleClass="btn-secondary" text="+ NUEVA TAREA" />
                                                </children>
                                            </HBox>
                                            <!--
                                                Tabla Tareas — 370px card, 32px padding → 338px tabla
                                                titulo(90) estado(52) prioridad(60) acciones(136) = 338
                                                tiempoTareasColumn → oculta (visible=false) para no romper @FXML
                                            -->
                                            <TableView fx:id="tareasTable" prefHeight="180.0" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="tituloTareasColumn" prefWidth="90.0" text="TÍTULO" />
                                                    <TableColumn fx:id="estadoTareasColumn" prefWidth="52.0" text="ESTADO" />
                                                    <TableColumn fx:id="prioridadTareasColumn" prefWidth="60.0" text="PRIOR." />
                                                    <TableColumn fx:id="tiempoTareasColumn" prefWidth="0.0" visible="false" text="TIEMPO" />
                                                    <TableColumn fx:id="accionesTareasColumn" prefWidth="136.0" text="ACCIONES" />
                                                </columns>
                                                <placeholder>
                                                    <Label style="-fx-text-fill: -app-text-secondary; -fx-font-size: 13px;"
                                                           text="Selecciona un sprint para ver sus tareas." />
                                                </placeholder>
                                            </TableView>
                                        </children>
                                    </VBox>

                                    <!-- ·· Card Competencias requeridas por la tarea ·· -->
                                    <VBox fx:id="competenciasSeccion" spacing="12.0"
                                          style="-fx-background-color: -app-bg-card;
                                                 -fx-background-radius: 8;
                                                 -fx-border-color: -app-border-soft;
                                                 -fx-border-radius: 8;
                                                 -fx-border-width: 1;"
                                          VBox.vgrow="ALWAYS">
                                        <padding>
                                            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                        </padding>
                                        <children>
                                            <HBox fx:id="cabeceraCompetencias" alignment="CENTER_LEFT" spacing="12.0">
                                                <children>
                                                    <ImageView fx:id="profileAvatar111"
                                                               fitHeight="32.0" fitWidth="32.0"
                                                               pickOnBounds="true" preserveRatio="true"
                                                               style="-fx-effect: dropshadow(gaussian, #00000019, 8, 0, 0, 2);">
                                                        <image><Image url="@../../icons/competencias.png" /></image>
                                                    </ImageView>
                                                    <Label styleClass="section-title"
                                                           text="Competencias Requeridas"
                                                           HBox.hgrow="ALWAYS" />
                                                    <Separator prefHeight="25.0" visible="false" HBox.hgrow="ALWAYS" />
                                                    <Button fx:id="btnAddCompetencia" mnemonicParsing="false"
                                                            onAction="#onNuevaCompetencia"
                                                            prefHeight="36.0" prefWidth="140.0"
                                                            styleClass="btn-secondary" text="+ COMPETENCIA" />
                                                </children>
                                            </HBox>
                                            <!--
                                                Tabla Competencias — 370px card, 32px padding → 338px tabla
                                                nombre(148) peso(60) acciones(130) = 338
                                            -->
                                            <TableView fx:id="competenciasTable" prefHeight="160.0" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="tituloTablaCompetencias" prefWidth="148.0" text="NOMBRE" />
                                                    <TableColumn fx:id="pesoTablaCompetencias" prefWidth="60.0" text="PESO" />
                                                    <TableColumn fx:id="accionesTablaCompetencias" prefWidth="130.0" text="ACCIONES" />
                                                </columns>
                                                <placeholder>
                                                    <Label style="-fx-text-fill: -app-text-secondary; -fx-font-size: 13px;"
                                                           text="Selecciona una tarea para ver sus competencias." />
                                                </placeholder>
                                            </TableView>
                                        </children>
                                    </VBox>

                                </VBox>
                                <!-- ── FIN columna derecha ── -->

                            </HBox>
                            <!-- ── FIN bloque dos columnas ── -->

                            <!-- Nodo fantasma -->
                            <HBox fx:id="actionButtons" visible="false" managed="false" />

                        </children>
                    </VBox>
                </content>
            </ScrollPane>
        </center>

    </BorderPane>
    <!-- ═══ FIN CAPA 0 ════════════════════════════════════════════ -->


    <!-- ═══════════════════════════════════════════════════════════
         CAPA 1 ─ OVERLAY OSCURO
         ═══════════════════════════════════════════════════════════ -->
    <Pane fx:id="overlayOscuro" mouseTransparent="true"
          onMouseClicked="#onCerrarDrawer" opacity="0"
          style="-fx-background-color: rgba(0,0,0,0.45);" />


    <!-- ═══════════════════════════════════════════════════════════
         CAPA 2 ─ PANEL DRAWER (desliza desde la derecha)
         ═══════════════════════════════════════════════════════════ -->
    <HBox fx:id="drawerWrapper" alignment="CENTER_RIGHT" mouseTransparent="true">
        <VBox fx:id="drawerPanel" maxWidth="380.0" mouseTransparent="true" prefWidth="380.0"
              style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, -4, 0);"
              translateX="380">
            <StackPane fx:id="drawerContenido" VBox.vgrow="ALWAYS" />
        </VBox>
    </HBox>
    <!-- ═══ FIN CAPA 2 ════════════════════════════════════════════ -->


</StackPane>
