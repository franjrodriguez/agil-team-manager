<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.iesaguadulce.agilteammanager.controller.ui.login.LoginController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: #1a1a2e; -fx-padding: 60;"
      prefWidth="450"
      prefHeight="600">

    <!-- Logo / Título -->
    <Label text="AgilTeam Manager"
           style="-fx-font-size: 32px; -fx-text-fill: #00d4ff; -fx-font-weight: bold;"/>

    <Label text="Gestión Inteligente de Equipos Ágiles"
           style="-fx-text-fill: #aaa; -fx-font-size: 14px;"/>

    <!-- Espaciador -->
    <Region VBox.vgrow="SOMETIMES"/>

    <!-- Campo Usuario -->
    <VBox spacing="8">
        <Label text="Usuario" style="-fx-text-fill: white;"/>
        <TextField fx:id="txtUsuario"
                   promptText="Introduce tu usuario"
                   style="-fx-pref-height: 45px; -fx-font-size: 14px;"/>
    </VBox>

    <!-- Campo Contraseña -->
    <VBox spacing="8">
        <Label text="Contraseña" style="-fx-text-fill: white;"/>
        <PasswordField fx:id="txtPassword"
                       promptText="Introduce tu contraseña"
                       style="-fx-pref-height: 45px; -fx-font-size: 14px;"/>
    </VBox>

    <!-- Botón Login -->
    <Button fx:id="btnLogin"
            text="Iniciar Sesión"
            onAction="#onLoginClick"
            defaultButton="true"
            style="-fx-background-color: #00d4ff;
                   -fx-text-fill: #1a1a2e;
                   -fx-font-weight: bold;
                   -fx-font-size: 16px;
                   -fx-pref-height: 50px;
                   -fx-background-radius: 25;
                   -fx-cursor: hand;"/>
    <!-- Botón Login -->
    <Button fx:id="btnCancel"
            text="Iniciar Sesión"
            onAction="#onCancelClick"
            defaultButton="true"
            style="-fx-background-color: #00d4ff;
                   -fx-text-fill: #1a1a2e;
                   -fx-font-weight: bold;
                   -fx-font-size: 16px;
                   -fx-pref-height: 50px;
                   -fx-background-radius: 25;
                   -fx-cursor: hand;"/>

    <!-- Espaciador -->
    <Region VBox.vgrow="SOMETIMES"/>

    <!-- Footer -->
    <Label text="v1.0 • FP DAM 2025"
           style="-fx-text-fill: #555; -fx-font-size: 10px;"/>

</VBox>