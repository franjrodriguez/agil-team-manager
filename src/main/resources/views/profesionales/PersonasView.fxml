<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!--
╔══════════════════════════════════════════════════════════════════╗
║  PersonasView.fxml  –  1200 × 806 px                            ║
║  Estilos: primer-light.css  +  agilteam-styles.css              ║
╚══════════════════════════════════════════════════════════════════╝
-->
<BorderPane fx:id="rootPane"
            prefHeight="806.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iesaguadulce.agilteammanager.controller.ui.personas.PersonasController">

    <stylesheets>
        <URL value="@../../css/primer-light.css" />
        <URL value="@../../css/agilteam-styles.css" />
    </stylesheets>

    <!-- ═══════════════════════════════════════════════════════
         TOP — Cabecera fija
         ═══════════════════════════════════════════════════════ -->
    <top>
        <HBox fx:id="headerBox" alignment="CENTER_LEFT" prefHeight="72.0" spacing="14.0"
              style="-fx-background-color: -app-bg-card;
                     -fx-border-color: -app-border-soft;
                     -fx-border-width: 0 0 1 0;">
            <padding><Insets top="0" right="24" bottom="0" left="24" /></padding>

            <ImageView fx:id="profileAvatar" fitHeight="40.0" fitWidth="40.0"
                       pickOnBounds="true" preserveRatio="true" />

            <VBox fx:id="headerInfo" alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                <Label fx:id="profileName" styleClass="section-title" text="Profesionales" />
                <Label fx:id="profileRole" styleClass="page-subtitle" text="Selecciona un profesional" />
            </VBox>

            <ComboBox fx:id="statusComboBox" prefHeight="34.0" prefWidth="140.0"
                      promptText="Estado" />

            <Button fx:id="btnDelete" mnemonicParsing="false"
                    prefHeight="36.0" prefWidth="160.0"
                    style="-fx-background-color: -app-error; -fx-text-fill: white;
                           -fx-background-radius: 6; -fx-font-weight: 600;"
                    text="Borrar Profesional" />
            <Button fx:id="btnSave" mnemonicParsing="false"
                    prefHeight="36.0" prefWidth="160.0"
                    styleClass="primary" text="Guardar Cambios" />
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════════════════
         LEFT — Panel lateral claro
         ═══════════════════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebarPanel" prefHeight="734.0" prefWidth="380.0" spacing="10.0"
              styleClass="app-panel" BorderPane.alignment="CENTER">
            <padding><Insets top="16" right="16" bottom="16" left="16" /></padding>

            <TextField fx:id="searchField" prefHeight="38.0"
                       promptText="Buscar profesional..." />

            <HBox fx:id="filterBox" spacing="6.0">
                <ComboBox fx:id="deptFilter" prefHeight="34.0" promptText="Dpto."
                          HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                <ComboBox fx:id="statusFilter" prefHeight="34.0" promptText="Estado"
                          HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
                <ComboBox fx:id="roleFilter" prefHeight="34.0" promptText="Rol"
                          HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" />
            </HBox>

            <Button fx:id="btnAddProfessional" mnemonicParsing="false"
                    prefHeight="38.0" prefWidth="400.0" styleClass="primary"
                    text="Añadir Profesional" />

            <ListView fx:id="professionalsListView" VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════════
         CENTER — Área de trabajo
         ═══════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fx:id="detailScrollPane" hbarPolicy="NEVER" fitToWidth="true"
                    BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="detailPane" spacing="16.0"
                      style="-fx-background-color: -app-bg-workspace;">
                    <padding><Insets top="28" right="32" bottom="32" left="32" /></padding>

                    <!-- Datos personales -->
                    <GridPane fx:id="personalDataGrid" hgap="16.0" vgap="12.0"
                              style="-fx-background-color: -app-bg-card;
                                     -fx-background-radius: 8;
                                     -fx-border-color: -app-border-soft;
                                     -fx-border-radius: 8;
                                     -fx-border-width: 1;
                                     -fx-padding: 16;">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        </rowConstraints>

                        <!-- Fila 0: etiquetas -->
                        <Label styleClass="form-label" text="NOMBRE" />
                        <Label styleClass="form-label" text="PUESTO DE TRABAJO"
                               GridPane.columnIndex="1" />
                        <!-- Fila 1: campos -->
                        <TextField fx:id="nombreField" prefHeight="36.0"
                                   promptText="Nombre completo"
                                   GridPane.rowIndex="1" />
                        <ComboBox fx:id="puestoComboBox" prefHeight="36.0"
                                  maxWidth="1.7976931348623157E308"
                                  promptText="Selecciona un puesto..."
                                  GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <!-- Fila 2: etiquetas -->
                        <Label styleClass="form-label" text="EMAIL"
                               GridPane.rowIndex="2" />
                        <Label styleClass="form-label" text="NOMBRE DE USUARIO"
                               GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <!-- Fila 3: campos -->
                        <TextField fx:id="emailField" prefHeight="36.0"
                                   promptText="correo@empresa.com"
                                   GridPane.rowIndex="3" />
                        <TextField fx:id="usernameField" prefHeight="36.0"
                                   promptText="nombre.usuario"
                                   GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <!-- Fila 4: etiquetas -->
                        <Label styleClass="form-label" text="SEXO / FECHA INCORPORACIÓN"
                               GridPane.rowIndex="4">
                            <GridPane.margin><Insets top="8.0" /></GridPane.margin>
                        </Label>
                        <Label styleClass="form-label" text="ROL DE SISTEMA"
                               GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <GridPane.margin><Insets top="8.0" /></GridPane.margin>
                        </Label>
                        <!-- Fila 5: campos -->
                        <HBox fx:id="sexJoinBox" alignment="CENTER_LEFT" spacing="12.0"
                              GridPane.rowIndex="5">
                            <ComboBox fx:id="sexComboBox" prefHeight="36.0" prefWidth="120.0"
                                      promptText="Sexo" />
                            <DatePicker fx:id="joinDatePicker" prefHeight="36.0" prefWidth="160.0"
                                        promptText="Fecha incorporación" />
                        </HBox>
                        <ComboBox fx:id="systemRoleComboBox" prefHeight="36.0"
                                  maxWidth="1.7976931348623157E308"
                                  promptText="Rol de sistema"
                                  GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    </GridPane>

                    <!-- Competencias técnicas -->
                    <VBox fx:id="competenciesSection" spacing="12.0"
                          style="-fx-background-color: -app-bg-card;
                                 -fx-background-radius: 8;
                                 -fx-border-color: -app-border-soft;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;
                                 -fx-padding: 16;">

                        <HBox fx:id="taskSectionHeader1" alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="section-title" text="Competencias Técnicas"
                                   HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnAddCompetencia" mnemonicParsing="false"
                                    onAction="#onAñadirCompetencia"
                                    prefHeight="32.0" prefWidth="32.0"
                                    styleClass="btn-secondary" text="+" />
                        </HBox>

                        <Separator />

                        <TableView fx:id="competenciesTable" prefHeight="180.0">
                            <columns>
                                <TableColumn fx:id="tipoColumn"                prefWidth="120.0" text="TIPO" />
                                <TableColumn fx:id="nombreColumn"              prefWidth="180.0" text="NOMBRE" />
                                <TableColumn fx:id="descripcionColumn"         prefWidth="280.0" text="DESCRIPCIÓN" />
                                <TableColumn fx:id="nivelColumn"               prefWidth="70.0"  text="NIVEL" />
                                <TableColumn fx:id="accionesCompetenciaColumn" prefWidth="60.0"  text="" />
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Tareas asignadas -->
                    <VBox fx:id="taskSection" spacing="12.0"
                          style="-fx-background-color: -app-bg-card;
                                 -fx-background-radius: 8;
                                 -fx-border-color: -app-border-soft;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;
                                 -fx-padding: 16;">

                        <HBox fx:id="taskSectionHeader" alignment="CENTER_LEFT">
                            <Label styleClass="section-title" text="Tareas Asignadas"
                                   HBox.hgrow="ALWAYS" />
                        </HBox>

                        <Separator />

                        <TableView fx:id="tasksTable" prefHeight="180.0">
                            <columns>
                                <TableColumn fx:id="prioColumn"      prefWidth="95.0"  text="PRIORIDAD" />
                                <TableColumn fx:id="tareaColumn"     prefWidth="250.0" text="TAREA" />
                                <TableColumn fx:id="fechaColumn"     prefWidth="120.0" text="FECHA" />
                                <TableColumn fx:id="horaColumn"      prefWidth="80.0"  text="HORA" />
                                <TableColumn fx:id="estadoColumn"    prefWidth="115.0" text="ESTADO" />
                                <TableColumn fx:id="completadoColumn" prefWidth="49.0" text="" />
                            </columns>
                        </TableView>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <!-- Nodos fantasma -->
                    <HBox fx:id="actionButtons" visible="false" managed="false" />

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
