<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="806.0" prefWidth="1200.0" styleClass="bg-default" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <stylesheets>
      <URL value="@../../css/primer-light.css" />
      <URL value="@../../css/agilteam-styles.css" />
   </stylesheets>
   <left>
      <VBox fx:id="sidebarPanel" prefHeight="806.0" prefWidth="380.0" spacing="16.0" styleClass="app-sidebar" BorderPane.alignment="CENTER">
         <children>
            <TextField fx:id="searchField" prefHeight="40.0" promptText="Buscar profesional..." />
            <HBox fx:id="filterBox" prefHeight="40.0" prefWidth="200.0" spacing="8.0">
               <children>
                  <ComboBox fx:id="deptFilter" prefWidth="116.0" promptText="DEPT" />
                  <ComboBox fx:id="statusFilter" layoutX="10.0" layoutY="10.0" prefWidth="116.0" promptText="STATUS" />
                  <ComboBox fx:id="roleFilter" layoutX="160.0" layoutY="10.0" prefWidth="116.0" promptText="ROL" />
               </children></HBox>
            <Button fx:id="btnAddProfessional" mnemonicParsing="false" prefHeight="40.0" prefWidth="400.0" styleClass="primary" text="Añadir Profesional" />
            <ListView fx:id="professionalsListView" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <ScrollPane fx:id="detailScrollPane" hbarPolicy="NEVER" prefHeight="200.0" prefWidth="200.0" style="-fx-fit-to-width: true;;" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="detailPane" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefHeight="200.0" spacing="24.0" style="-fx-background-color: -app-bg-workspace;;">
               <padding>
                  <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
               </padding>
               <children>
                  <HBox fx:id="headerBox" alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="200.0" spacing="16.0">
                     <children>
                        <ImageView fx:id="profileAvatar" fitHeight="64.0" fitWidth="64.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, #00000019, 8, 0, 0, 2);;" />
                        <VBox fx:id="headerInfo" alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="profileName" styleClass="page-title" text="Carlos Rodriguez" />
                              <Label fx:id="profileRole" layoutX="10.0" layoutY="10.0" styleClass="page-subtitle" text="Software Arquitect" />
                           </children>
                        </VBox>
                        <ComboBox fx:id="statusComboBox" prefHeight="36.0" prefWidth="150.0" promptText="Activo" style="-fx-background-color: -app-success;" />
                     </children>
                  </HBox>
                  <GridPane fx:id="personalDataGrid" hgap="24.0" style="-fx-background-color: -app-bg-card;; -fx-background-radius: 8;;" vgap="16.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints />
                      <RowConstraints />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                     <children>
                        <Label style="-fx-text-fill: -app-text-secondary;;" styleClass="form-label" text="EMAIL" />
                        <Label style="-fx-text-fill: -app-text-secondary;" styleClass="form-label" text="NOMBRE DE USUARIO" GridPane.columnIndex="1" />
                        <TextField fx:id="emailField" prefHeight="36.0" promptText="c.rodriguez@company.com" GridPane.rowIndex="1" />
                        <TextField fx:id="usernameField" prefHeight="36.0" promptText="crodriguez_arch" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label style="-fx-text-fill: -app-text-secondary;" styleClass="form-label" text="SEXO / FECHA INCORPORACIÓN" GridPane.rowIndex="2">
                           <GridPane.margin>
                              <Insets bottom="8.0" top="8.0" />
                           </GridPane.margin>
                        </Label>
                        <Label style="-fx-text-fill: -app-text-secondary;" styleClass="form-label" text="ROL DE SISTEMA" GridPane.columnIndex="1" GridPane.rowIndex="2">
                           <GridPane.margin>
                              <Insets bottom="8.0" top="8.0" />
                           </GridPane.margin>
                        </Label>
                        <HBox fx:id="sexJoinBox" alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="12.0" GridPane.rowIndex="3">
                           <children>
                              <ComboBox fx:id="sexComboBox" prefHeight="36.0" prefWidth="120.0" promptText="Hombre" />
                              <DatePicker fx:id="joinDatePicker" prefHeight="36.0" prefWidth="150.0" promptText="12 May 2021" />
                           </children>
                        </HBox>
                        <ComboBox fx:id="systemRoleComboBox" maxWidth="1.7976931348623157E308" prefHeight="36.0" promptText="Technical Lead" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                     </children>
                  </GridPane>
                  <VBox fx:id="taskSection" prefHeight="200.0" prefWidth="100.0" spacing="12.0" style="-fx-background-color: -app-bg-card; -fx-background-radius: 8;">
                     <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                     <children>
                        <HBox fx:id="taskSectionHeader" alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="12.0">
                           <children>
                              <Label styleClass="section-title" text="📋 Tareas Asignadas" HBox.hgrow="ALWAYS" />
                           </children></HBox>
                        <TableView fx:id="tasksTable" prefHeight="200.0" prefWidth="200.0">
                          <columns>
                            <TableColumn fx:id="prioColumn" prefWidth="95.0" text="PRIORIDAD" />
                            <TableColumn fx:id="tareaColumn" prefWidth="250.0" text="TAREA" />
                              <TableColumn fx:id="fechaColumn" prefWidth="120.0" text="FECHA" />
                              <TableColumn fx:id="horaColumn" text="HORA" />
                              <TableColumn fx:id="estadoColumn" prefWidth="115.0" text="ESTADO" />
                              <TableColumn fx:id="completadoColumn" prefWidth="49.0" />
                          </columns>
                        </TableView>
                     </children>
                  </VBox>
                  <VBox fx:id="competenciesSection" layoutX="42.0" layoutY="315.0" prefHeight="200.0" prefWidth="100.0" spacing="12.0" style="-fx-background-color: -app-bg-card; -fx-background-radius: 8;">
                     <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                     <children>
                        <HBox fx:id="taskSectionHeader1" alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="12.0">
                           <children>
                              <Label styleClass="section-title" text="Competencias Técnicas" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <TableView fx:id="competenciesTable" prefHeight="200.0" prefWidth="200.0">
                           <columns>
                              <TableColumn fx:id="tipoColumn" prefWidth="132.0" text="TIPO" />
                              <TableColumn fx:id="nombreColumn" prefWidth="197.0" text="NOMBRE" />
                              <TableColumn fx:id="descripcionColumn" prefWidth="378.0" text="DESCRIPCIÓN" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
                  <HBox fx:id="actionButtons" alignment="CENTER_RIGHT" layoutX="42.0" layoutY="42.0" prefHeight="80.0" prefWidth="200.0" spacing="16.0">
                     <children>
                        <Button fx:id="btnDelete" mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: -app-error; -fx-text-fill: white;" text="Borrar Profesional" />
                        <Button fx:id="btnSave" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" styleClass="primary" text="Guardar Cambios" />
                     </children>
                     <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
