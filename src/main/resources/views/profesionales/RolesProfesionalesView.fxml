<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
╔══════════════════════════════════════════════════════════════════╗
║  RolesProfesionalesView.fxml  –  1200 × 806 px                  ║
║  Estilos: primer-light.css  +  agilteam-styles.css              ║
╚══════════════════════════════════════════════════════════════════╝
-->
<BorderPane fx:id="rootPane"
            prefHeight="806.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iesaguadulce.agilteammanager.controller.ui.personas.RolesProfesionalesController">

    <stylesheets>
        <URL value="@../../css/primer-light.css" />
        <URL value="@../../css/agilteam-styles.css" />
    </stylesheets>

    <!-- ═══════════════════════════════════════════════════════
         TOP — Cabecera fija (igual que MotorAsignacionView)
         ═══════════════════════════════════════════════════════ -->
    <top>
        <HBox fx:id="headerBox" alignment="CENTER_LEFT" prefHeight="72.0" spacing="16.0"
              style="-fx-background-color: -app-bg-card;
                     -fx-border-color: -app-border-soft;
                     -fx-border-width: 0 0 1 0;">
            <padding><Insets top="0" right="24" bottom="0" left="24" /></padding>

            <ImageView fx:id="profileAvatar" fitHeight="40.0" fitWidth="40.0"
                       pickOnBounds="true" preserveRatio="true">
                <image><Image url="@../../icons/role.png" /></image>
            </ImageView>

            <VBox fx:id="headerInfo" alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                <Label fx:id="profileName" styleClass="section-title" text="Puestos de Trabajo" />
                <Label styleClass="page-subtitle" text="Gestión de roles profesionales" />
            </VBox>

            <!-- Botones en la cabecera -->
            <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#borrarPuesto"
                    prefHeight="36.0" prefWidth="160.0"
                    style="-fx-background-color: -app-error; -fx-text-fill: white;
                           -fx-background-radius: 6; -fx-font-weight: 600;"
                    text="Borrar Puesto" />
            <Button fx:id="btnSave" mnemonicParsing="false" onAction="#guardarPuesto"
                    prefHeight="36.0" prefWidth="160.0"
                    styleClass="primary" text="Guardar Cambios" />
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════════════════
         LEFT — Sidebar oscuro con búsqueda y lista
         ═══════════════════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebarPanel" prefHeight="734.0" prefWidth="380.0" spacing="12.0"
              styleClass="app-panel" BorderPane.alignment="CENTER">
            <padding><Insets top="16" right="16" bottom="16" left="16" /></padding>

            <TextField fx:id="searchField" onKeyReleased="#filtrarLista"
                       prefHeight="38.0" promptText="Buscar puesto de trabajo..." />

            <Button fx:id="btnAddPuestoTrabajo" mnemonicParsing="false" onAction="#nuevoPuesto"
                    prefHeight="38.0" prefWidth="400.0" styleClass="primary"
                    text="Añadir Puesto" />

            <ListView fx:id="puestotrabajoListView" onMouseClicked="#seleccionarPuesto"
                      VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════════
         CENTER — Área de trabajo con formulario
         ═══════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fx:id="detailScrollPane" hbarPolicy="NEVER" fitToWidth="true"
                    BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="detailPane" spacing="16.0"
                      style="-fx-background-color: -app-bg-workspace;">
                    <padding><Insets top="28" right="32" bottom="32" left="32" /></padding>

                    <!-- Nombre del puesto -->
                    <VBox spacing="6.0"
                          style="-fx-background-color: -app-bg-card;
                                 -fx-background-radius: 8;
                                 -fx-border-color: -app-border-soft;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;
                                 -fx-padding: 16;">
                        <Label styleClass="form-label" text="NOMBRE DEL PUESTO" />
                        <TextField fx:id="nombreField" prefHeight="36.0"
                                   promptText="Nombre del puesto de trabajo" />
                    </VBox>

                    <!-- Descripción -->
                    <VBox fx:id="descripcionBox" spacing="6.0"
                          style="-fx-background-color: -app-bg-card;
                                 -fx-background-radius: 8;
                                 -fx-border-color: -app-border-soft;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;
                                 -fx-padding: 16;">
                        <Label fx:id="descripcionLabel" styleClass="form-label"
                               text="DESCRIPCIÓN DETALLADA" />
                        <TextArea fx:id="descripcionField" prefHeight="120.0"
                                  promptText="Descripción detallada del puesto de trabajo..."
                                  wrapText="true" />
                    </VBox>

                    <!-- Elementos relacionados -->
                    <VBox fx:id="relationSection" spacing="12.0"
                          style="-fx-background-color: -app-bg-card;
                                 -fx-background-radius: 8;
                                 -fx-border-color: -app-border-soft;
                                 -fx-border-radius: 8;
                                 -fx-border-width: 1;
                                 -fx-padding: 16;">

                        <HBox fx:id="taskSectionHeader" alignment="CENTER_LEFT" spacing="10.0">
                            <ImageView fitHeight="24.0" fitWidth="24.0"
                                       pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../../icons/relacionado.png" /></image>
                            </ImageView>
                            <Label styleClass="section-title" text="Elementos Relacionados"
                                   HBox.hgrow="ALWAYS" />
                        </HBox>

                        <Separator />

                        <Label styleClass="page-subtitle"
                               text="Las personas y competencias asociadas a este puesto aparecerán aquí." />
                    </VBox>

                    <!-- Spacer -->
                    <Region VBox.vgrow="ALWAYS" />

                    <!-- fx:id fantasma para el controller (label no visible) -->
                    <Label fx:id="labelNombre" visible="false" managed="false" />
                    <HBox fx:id="actionButtons" visible="false" managed="false" />

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
