<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!--
╔══════════════════════════════════════════════════════════════════╗
║  UsuariosView.fxml  –  1200 × 806 px                            ║
║  Estilos: primer-light.css  +  agilteam-styles.css              ║
╚══════════════════════════════════════════════════════════════════╝
-->

<BorderPane fx:id="rootPane" prefHeight="806.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iesaguadulce.agilteammanager.controller.ui.seguridad.UsuariosController">

    <stylesheets>
        <URL value="@../../css/primer-light.css" />
        <URL value="@../../css/agilteam-styles.css" />
    </stylesheets>

    <!-- ═══════════════════════════════════════════════════════
         TOP — Cabecera fija
         ═══════════════════════════════════════════════════════ -->
    <top>
        <HBox fx:id="headerBox" alignment="CENTER_LEFT" prefHeight="72.0" spacing="14.0" style="-fx-background-color: -app-bg-card;                      -fx-border-color: -app-border-soft;                      -fx-border-width: 0 0 1 0;">
            <padding><Insets bottom="0" left="24" right="24" top="0" /></padding>

            <!-- Avatar dinámico (el controller asigna la imagen) -->
            <ImageView fx:id="imgCrud" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../../icons/users.png" />
            </image></ImageView>

            <VBox fx:id="headerInfo" alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                <Label fx:id="profileName" styleClass="section-title" text="Usuarios" />
                <Label fx:id="profileRole" styleClass="page-subtitle" text="Selecciona un usuario" />
            </VBox>

            <!-- Badge de estado -->
            <ComboBox fx:id="statusComboBox" prefHeight="34.0" prefWidth="140.0" promptText="Estado" />

            <Button fx:id="btnDelete" mnemonicParsing="false" prefHeight="36.0" prefWidth="160.0" style="-fx-background-color: -app-error; -fx-text-fill: white;                            -fx-background-radius: 6; -fx-font-weight: 600;" text="Borrar Usuario" />
            <Button fx:id="btnSave" mnemonicParsing="false" prefHeight="36.0" prefWidth="160.0" styleClass="primary" text="Guardar Cambios" />
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════════════════
         LEFT — Panel lateral claro
         ═══════════════════════════════════════════════════════ -->
    <left>
        <VBox fx:id="sidebarPanel" prefHeight="734.0" prefWidth="380.0" spacing="10.0" styleClass="app-panel" BorderPane.alignment="CENTER">
            <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>

            <TextField fx:id="searchField" prefHeight="38.0" promptText="Buscar usuario..." />

            <!-- Filtros -->
            <HBox fx:id="filterBox" spacing="6.0">
                <ComboBox fx:id="deptFilter" maxWidth="1.7976931348623157E308" prefHeight="34.0" promptText="Dpto." HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="statusFilter" maxWidth="1.7976931348623157E308" prefHeight="34.0" promptText="Estado" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="roleFilter" maxWidth="1.7976931348623157E308" prefHeight="34.0" promptText="Rol" HBox.hgrow="ALWAYS" />
            </HBox>

            <Button fx:id="btnAddProfessional" mnemonicParsing="false" prefHeight="38.0" prefWidth="400.0" styleClass="primary" text="Añadir Usuario" />

            <ListView fx:id="professionalsListView" VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════════
         CENTER — Área de trabajo
         ═══════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fx:id="detailScrollPane" fitToWidth="true" hbarPolicy="NEVER" BorderPane.alignment="CENTER">
            <content>
                <HBox fx:id="detailPane" minHeight="734.0" style="-fx-background-color: -app-bg-workspace;">

                    <!-- Columna izquierda: formulario (crece para ocupar el espacio disponible) -->
                    <VBox spacing="16.0" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="32" left="32" right="32" top="28" /></padding>

                        <!-- Credenciales -->
                        <VBox fx:id="credencialesSection" spacing="16.0" style="-fx-background-color: -app-bg-card;                                      -fx-background-radius: 8;                                      -fx-border-color: -app-border-soft;                                      -fx-border-radius: 8;                                      -fx-border-width: 1;                                      -fx-padding: 16;">

                            <HBox fx:id="taskSectionHeader2" alignment="CENTER_LEFT" spacing="10.0">
                                <ImageView fx:id="profileAvatar1" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                    <image><Image url="@../../icons/KeyTitle.png" /></image>
                                </ImageView>
                                <Label styleClass="section-title" text="Credenciales de acceso" HBox.hgrow="ALWAYS" />
                            </HBox>

                            <Separator />

                            <VBox spacing="6.0">
                                <Label styleClass="form-label" text="USUARIO" />
                                <TextField fx:id="emailField" prefHeight="36.0" promptText="Nombre de usuario para acceder al sistema" />
                            </VBox>

                            <VBox spacing="6.0">
                                <Label styleClass="form-label" text="CONTRASEÑA" />
                                <TextField fx:id="passwordField" prefHeight="36.0" promptText="Introduce una contraseña válida" />
                            </VBox>

                            <VBox spacing="6.0">
                                <Label styleClass="form-label" text="ROL DE SISTEMA" />
                                <ComboBox fx:id="systemRoleComboBox" editable="true" maxWidth="1.7976931348623157E308" prefHeight="36.0" promptText="Determina los permisos de acceso" />
                            </VBox>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Nodos fantasma -->
                        <HBox fx:id="actionButtons" managed="false" visible="false" />
                    </VBox>

                    <!-- Columna derecha: perfil visual (ancho fijo) -->
                    <VBox alignment="CENTER" spacing="16.0"
                          prefWidth="240.0" minWidth="200.0" HBox.hgrow="NEVER"
                          style="-fx-background-color: -app-bg-card;
                                 -fx-border-color: -app-border-soft;
                                 -fx-border-width: 0 0 0 1;">
                        <padding><Insets top="28" right="20" bottom="28" left="20" /></padding>
                        <ImageView fx:id="profileAvatar" fitHeight="160.0" fitWidth="160.0"
                                   pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../../icons/user-locked.png" /></image>
                        </ImageView>
                        <Label fx:id="puestoLabel" styleClass="section-title" text="—"
                               wrapText="true" style="-fx-text-alignment: center;" />
                        <Label fx:id="puestoDescLabel" styleClass="page-subtitle" text=""
                               wrapText="true" style="-fx-text-alignment: center;" />
                    </VBox>

                </HBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
