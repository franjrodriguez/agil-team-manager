<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
╔══════════════════════════════════════════════════════════════════╗
║  LoginView.fxml  –  450 × 600 px                                ║
║  Fondo oscuro (app-bg-header) + tarjeta blanca central          ║
╚══════════════════════════════════════════════════════════════════╝
-->

<StackPane prefHeight="600.0" prefWidth="450.0" style="-fx-background-color: #0F1419;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iesaguadulce.agilteammanager.controller.ui.login.LoginController">

    <stylesheets>
        <URL value="@../../css/primer-light.css" />
        <URL value="@../../css/agilteam-styles.css" />
    </stylesheets>

    <!-- Contenido centrado verticalmente -->
    <VBox alignment="CENTER" spacing="0.0">
        <padding><Insets bottom="32" left="40" right="40" top="32" /></padding>

        <!-- ── Logo ── -->
        <ImageView fitHeight="80.0" fitWidth="320.0" pickOnBounds="true" preserveRatio="true">
            <image><Image url="@../../assets/logo_oscuro.png" /></image>
        </ImageView>

        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 13px; -fx-padding: 6 0 28 0;" text="Gestión Inteligente de Equipos Ágiles" />

        <!-- ── Tarjeta blanca del formulario ── -->
        <VBox spacing="16.0" style="-fx-background-color: white;                      -fx-background-radius: 12;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 24, 0, 0, 8);                      -fx-padding: 28 28 24 28;">

            <!-- Usuario -->
            <VBox spacing="6.0">
                <Label style="-fx-text-fill: #374151;" styleClass="form-label" text="USUARIO" />
                <TextField fx:id="txtUsuario" prefHeight="42.0" promptText="Introduce tu usuario" />
            </VBox>

            <!-- Contraseña -->
            <VBox spacing="6.0">
                <Label style="-fx-text-fill: #374151;" styleClass="form-label" text="CONTRASEÑA" />
                <PasswordField fx:id="txtPassword" prefHeight="42.0" promptText="Introduce tu contraseña" />
            </VBox>

            <!-- Botón Iniciar Sesión -->
            <Button fx:id="btnLogin" defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#onLoginClick" prefHeight="44.0" style="-fx-background-color: #00D4FF;                            -fx-text-fill: #0F1419;                            -fx-font-weight: 700;                            -fx-font-size: 14px;                            -fx-background-radius: 8;                            -fx-cursor: hand;" text="Iniciar Sesión" />

            <!-- Separador visual -->
            <Region prefHeight="2.0" />

            <!-- Botón Salir -->
            <Button fx:id="btnCancel" cancelButton="true" maxWidth="1.7976931348623157E308" onAction="#onCancelClick" prefHeight="38.0" style="-fx-background-color: #FEE2E2;                            -fx-text-fill: #B91C1C;                            -fx-font-size: 13px;                            -fx-font-weight: 600;                            -fx-border-color: #FECACA;                            -fx-border-radius: 8;                            -fx-background-radius: 8;                            -fx-cursor: hand;" text="Salir" />
        </VBox>

        <!-- ── Footer ── -->
        <HBox alignment="CENTER" spacing="8.0">
            <padding><Insets top="20" /></padding>
            <Label style="-fx-text-fill: #374151; -fx-font-size: 11px;" text="AgilTeam Manager · v1.0" />
            <Label style="-fx-text-fill: #374151;" text="·" />
            <Label style="-fx-text-fill: #374151; -fx-font-size: 11px;" text="FP DAM 2025/26" />
        </HBox>

    </VBox>

</StackPane>
